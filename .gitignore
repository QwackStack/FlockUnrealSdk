# ────────────────────────────────────────────────────────────
#  Unreal Engine — build artifacts & generated output
#  (mirrors the Flock Unity SDK's intent: never commit generated
#   build output; do commit source, config, .uplugin and Resources)
# ────────────────────────────────────────────────────────────
Binaries/
Intermediate/
DerivedDataCache/
Saved/

# Compiled / linker output
*.dll
*.exe
*.pdb
*.exp
*.lib
*.app
*.ipa
*.dSYM/

# UnrealBuildTool generated
*.target
*.modules
*.version

# ────────────────────────────────────────────────────────────
#  Generated IDE / project files
# ────────────────────────────────────────────────────────────
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj/
*.xcworkspace/
.vs/
.vsconfig

# IDEs
.idea/
.vscode/

# ────────────────────────────────────────────────────────────
#  Local tooling — parity with the Flock Unity SDK's .gitignore
# ────────────────────────────────────────────────────────────
# Local Claude Code context (not shared)
CLAUDE.md
CLAUDE.local.md
.claude/
.editorconfig

# graphify knowledge graph output (local-only)
graphify-out/

# Documentation splits two ways, and the split is the point:
#   Documentation/  — the shipped guides the README links to. Committed.
#   docs/           — maintainer-only specs and plans. Local, never shipped.
# Ignoring docs/ wholesale rather than docs/superpowers/ so anything dropped in there
# is private by default; a working note should never need a .gitignore edit to stay local.
Documentation~/
docs/

# ────────────────────────────────────────────────────────────
#  OS cruft
# ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
